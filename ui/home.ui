     <property name="styleSheet">
      <string notr="true">/* QPushButton */
QPushButton {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1DB954, stop:1 #15883e
    );
    color: white;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #1ed760, stop:1 #1aa34a
    );
}
QPushButton:pressed {
    background-color: #0d5727;
}</string>
